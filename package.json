{
  "name": "nestjs-cloudinary-community",
  "version": "0.3.1",
  "description": "Unofficial, community-maintained NestJS module for the Cloudinary service. Not affiliated with Cloudinary Ltd.",
  "author": {
    "name": "francoabottaro",
    "url": "https://francobottaro.vercel.app/"
  },
  "funding": {
    "type": "url",
    "url": "https://francobottaro.vercel.app/"
  },
  "contributors": [],
  "private": false,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nestjs",
    "cloudinary",
    "unofficial",
    "community",
    "image-upload",
    "module"
  ],
  "homepage": "https://github.com/francoabottaro/nestjs-cloudinary-community",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francoabottaro/nestjs-cloudinary-community.git"
  },
  "bugs": {
    "url": "https://github.com/francoabottaro/nestjs-cloudinary-community/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "nestjs-cloudinary-community": "scripts/init.js"
  },
  "files": [
    "dist",
    "scripts",
    ".env.example",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/platform-express": "^10.0.0 || ^11.0.0",
    "cloudinary": "^2.0.0",
    "reflect-metadata": "^0.1.14 || ^0.2.0",
    "rxjs": "^7.8.1"
  },
  "dependencies": {},
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "prepare": "husky",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest && jest --config jest.config.scripts.cjs",
    "test:scripts": "jest --config jest.config.scripts.cjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "cloudinary": "^2.10.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.1.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
